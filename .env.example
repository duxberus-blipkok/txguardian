# ============================================
# TxGuardian environment variables
# Salin file ini menjadi .env.local dan isi nilainya.
# SEMUA key di sini server-side only — JANGAN pakai prefix NEXT_PUBLIC_
# ============================================

# Helius RPC
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# OpenRouter (LLM explainer)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3
# Opsional, untuk ranking di openrouter.ai
OPENROUTER_SITE_URL=https://txguardian.local
OPENROUTER_SITE_NAME=TxGuardian

# Supabase (opsional untuk MVP — receipt & log)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Keypair penanda receipt (base58 secret key). Generate dgn: node scripts/gen-signer.mjs
RECEIPT_SIGNER_SECRET=
